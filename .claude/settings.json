{
  "language": "spanish",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3.10 /Users/hcabrera/Documents/Personal_Documents/TesisUrbanismo/.claude/hooks/session_start_watermarks.py",
            "timeout": 5,
            "statusMessage": "Verificando servidor de watermarks..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3.10 /Users/hcabrera/Documents/Personal_Documents/TesisUrbanismo/.claude/hooks/check_watermarks.py",
            "timeout": 15,
            "statusMessage": "Verificando marcas IA antes de escribir..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(xelatex *)",
      "Bash(bibtex *)",
      "Bash(biber *)",
      "Bash(latexmk *)",
      "Bash(make *)",
      "Bash(python3 tools/formatter.py *)",
      "Bash(python3 tools/formatter.py)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  },
  "env": {
    "LATEX_ENGINE": "xelatex",
    "BIB_ENGINE": "bibtex",
    "MAIN_FILE": "tesis.tex",
    "COMMANDS_FILE": "Latex/Comands.tex",
    "BIB_FILE": "referencias.bib"
  }
}